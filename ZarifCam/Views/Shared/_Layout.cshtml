                    </button>
                </form>
            </div>
        </div>

        <!-- Masaüstü Navigasyon -->
        <div class="nav-wrapper">
            <div class="container">
                <nav class="desktop-nav">
                    <a href="/Urunler" class="nav-link">Tüm Ürünler</a>
                    <div class="nav-dropdown">
                        <a href="#" class="nav-link">Kategoriler <i class="fas fa-chevron-down"></i></a>
                        <div class="dropdown-content">
                        </div>
                    </div>
                    <a href="/Atolyemiz" class="nav-link">Atölyemiz</a>
                  
                    <a href="/Home/Hakkimizda" class="nav-link">Hakkımızda</a>
