                    </a>
                    <a href="https://www.instagram.com/zarif_cam" target="_blank" class="top-link">
                        <i class="fab fa-instagram"></i>
                    </a>
                </div>
                <div class="top-center">
                    <span>2500 TL Üzeri Alışverişlerde Kargo Ücretsiz</span>
                </div>
                <div class="top-right">
                    <a href="/SiparisTakip">Sipariş Takibi</a>
                    <a href="/Yardim">Yardım & Destek</a>
                </div>
            </div>
        </div>

        <!-- Ana Header (Logo + İkonlar) -->
        <div class="header-main">
            <div class="container">
                <!-- Hamburger Menü Butonu (Mobil) -->
                <button class="hamburger-btn" id="hamburgerBtn">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <!-- Logo -->
                <a href="/" class="logo">
                    <div class="logo-text">
                        <span class="brand">ZarifCam</span>
                        <span class="slogan">Camın Zarif Dünyası</span>
                    </div>
                </a>

                <!-- Sağ İkonlar -->
                <div class="header-actions">
                    <a href="/Favoriler" class="action-icon">
                        <i class="fas fa-heart"></i>
                        <span class="badge">3</span>
                    </a>
                    <a href="/Sepet" class="action-icon">
                        <i class="fas fa-shopping-cart"></i>
                        <span class="badge">2</span>
                    </a>
                    <a href="/Hesabim" class="action-icon">
