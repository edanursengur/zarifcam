                <a href="/Kategori"><i class="fas fa-th-large"></i> Kategoriler</a>
                <a href="/Atolyemiz"><i class="fas fa-palette"></i> Atölyemiz</a>
                <a href="/Home/Hakkimizda"><i class="fas fa-info-circle"></i> Hakkımızda</a>
                <a href="/Home/Iletisim"><i class="fas fa-phone-alt"></i> İletişim</a>
                <a href="/Indirim"><i class="fas fa-percentage"></i> İndirimli Ürünler</a>
