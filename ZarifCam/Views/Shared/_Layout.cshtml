                    </a>
                </div>
            </div>
        </div>

        <!-- Arama Çubuğu (Mobilde logo altında, masaüstünde yan tarafta) -->
        <div class="search-wrapper">
            <div class="container">
                <form action="/Ara" method="get" class="search-form">
                    <input type="text" name="q" placeholder="Ürün ara, binlerce cam ürünü keşfet..." class="search-input">
                    <button type="submit" class="search-submit">
