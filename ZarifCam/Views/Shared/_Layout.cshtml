                <button class="mobile-menu-close" id="closeMenuBtn">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="mobile-menu-search">
                <form action="/Ara" method="get" class="mobile-search-form">
                    <input type="text" name="q" placeholder="Ürün ara..." class="mobile-search-input">
                    <button type="submit" class="mobile-search-btn">
