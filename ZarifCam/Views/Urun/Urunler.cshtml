<script>
     // Sayfa açılınca ilk yük
    window.addEventListener("DOMContentLoaded", () => {
        urunleriGetirVeBas();
    });

    // Infinite scroll
    window.addEventListener("scroll", () => {
        if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 200) {
            urunleriGetirVeBas();
        }
    });
    let page = 1;
    const pageSize = 30;
    let loading = false;

    async function urunleriGetirVeBas() {
        if (loading) return;
        loading = true;

        const container = document.getElementById("urun-listesi");

        const response = await fetch(`/api/WebUrun/urun-kartlari?page=${page}&pageSize=${pageSize}`);
        const urunler = await response.json();

        urunler.forEach(urun => {
            const sliderImgs = (urun.gorseller || [])
                .map(img => `<img src="${img}" />`)
                .join('');

            const cardHtml = `
            <div class="product-card" data-urunid="${urun.urunId}">
                <div class="card-slider">
                    <div class="slider-track">
                        ${sliderImgs}
                    </div>
                </div>
                <div class="card-info">
                    <span class="card-category">${urun.kategoriAdi}</span>
                    <h3 class="card-title">${urun.urunAdi}</h3>
                    <span class="card-price">${urun.dovizSembol}${urun.fiyat}</span>
                </div>
            </div>
            `;

            container.insertAdjacentHTML('beforeend', cardHtml);
        });

        baslatKartSliderlari();
        page++;
        loading = false;
    }

       function baslatKartSliderlari() {
        document.querySelectorAll(".product-card").forEach(card => {

            // 🛑 Aynı karta tekrar tekrar bağlama
            if (card.dataset.init) return;
            card.dataset.init = "1";

            const track = card.querySelector(".slider-track");
            const images = track.querySelectorAll("img");

            let index = 0;
            let interval;

            // 🎞️ Slider
            if (images.length > 1) {
                interval = setInterval(() => {
                    index = (index + 1) % images.length;
                    track.style.transform = `translateX(-${index * 100}%)`;
                }, 2500);
            }

            // 👉 TIKLAMA = DETAY
            card.addEventListener("click", () => {
                const urunId = card.dataset.urunid;
                window.location.href = `/Urun/Detay/${urunId}`;
            });
        });
    }


</script>
