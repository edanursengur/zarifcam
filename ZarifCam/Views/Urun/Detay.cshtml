@page "/urun/detay/{id:int}"
<link rel="stylesheet" href="~/css/urun/urundetay.css" asp-append-version="true" />

<div class="product-detail-container">
    <!-- Breadcrumb -->
    <div class="breadcrumb">
        <a href="/">Ana Sayfa</a>
        <span>/</span>
        <a href="/urunler">Tüm Ürünler</a>
        <span>/</span>
        <span class="current" id="productBreadcrumb">Ürün Yükleniyor...</span>
    </div>

    <div id="productDetailContent">
        <div class="loading-spinner">Ürün detayları yükleniyor...</div>
    </div>

    <!-- Ürün Açıklaması ve Detaylar - Dinamik doldurulacak -->
    <div class="product-tabs" id="productTabs" style="display: none;">
        <div class="tab-headers">
            <button class="tab-btn active" data-tab="description">Ürün Açıklaması</button>
            <button class="tab-btn" data-tab="details">Teknik Detaylar</button>
            <button class="tab-btn" data-tab="reviews">Yorumlar (<span id="reviewCount">0</span>)</button>
        </div>

        <div class="tab-contents">
            <div class="tab-content active" id="descriptionContent">
                <div class="product-description" id="productDescription">
                    <!-- Açıklama buraya gelecek -->
                </div>
            </div>

            <div class="tab-content" id="detailsContent">
                <div id="technicalDetails">
                    <!-- Teknik detaylar buraya gelecek -->
                </div>
            </div>

            <div class="tab-content" id="reviewsContent">
                <div id="reviewsList">
                    <!-- Yorumlar buraya gelecek -->
                </div>
            </div>
        </div>
    </div>

    <!-- Benzer Ürünler -->
    <div class="similar-products" id="similarProducts" style="display: none;">
        <h2 class="section-title">Benzer Ürünler</h2>
        <div class="similar-products-slider">
            <div class="similar-products-track" id="similarProductsTrack">
                <!-- Benzer ürünler buraya gelecek -->
            </div>
            <button class="similar-prev">‹</button>
            <button class="similar-next">›</button>
        </div>
    </div>
</div>

<script>
        // Ürün Detay Sayfası JavaScript - API'den tüm verileri çeker
      // Ürün Detay Sayfası JavaScript - Düzeltilmiş Versiyon
    document.addEventListener('DOMContentLoaded', function() {
        // URL'den ID'yi al
        const pathParts = window.location.pathname.split('/');
        const productId = pathParts[pathParts.length - 1];

        if (productId) {
            loadProductDetail(productId);
        }

        async function loadProductDetail(id) {
            try {
                const response = await fetch(`/api/anasayfa/urun-detay/${id}`);
                const result = await response.json();

                if (result.Success && result.Data) {
                    renderProductDetail(result.Data);
                    renderTechnicalDetails(result.Data);
                    renderReviews(result.Data);
                    renderSimilarProducts(result.Data);
                } else {
                    showError('Ürün bulunamadı');
                }
            } catch (error) {
                console.error('Ürün detayı yüklenirken hata:', error);
                showError('Ürün yüklenirken bir hata oluştu');
            }
        }

        function renderProductDetail(product) {
            // Breadcrumb güncelle
            document.getElementById('productBreadcrumb').textContent = product.Ad;

            // Ana içeriği oluştur
            const discountPercent = product.EskiFiyat && product.EskiFiyat > product.Fiyat
                ? Math.round(((product.EskiFiyat - product.Fiyat) / product.EskiFiyat) * 100)
                : null;

            const taksitMiktari = product.TaksitSecenekleri || 6;
            const taksitFiyati = (product.IndirimliFiyat || product.Fiyat) / taksitMiktari;

            const html = `
                <div class="product-detail-wrapper">
                    <!-- Sol: Görsel Galerisi -->
                    <div class="product-gallery">
                        <div class="main-image">
                            <img id="mainProductImage" src="${product.AnaGorsel || '/images/placeholder.jpg'}" alt="${product.Ad}">
                            <button class="zoom-btn" id="zoomBtn">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/>
                                    <path d="M16 16L21 21" stroke="currentColor" stroke-width="2"/>
                                </svg>
                            </button>
                        </div>

                        ${product.DigerGorseller && product.DigerGorseller.length > 0 ? `
                            <div class="thumbnail-list">
                                <button class="thumb-nav prev-thumb">‹</button>
                                <div class="thumbnails">
                                    <div class="thumb-item active" data-image="${product.AnaGorsel}">
                                        <img src="${product.AnaGorsel}" alt="Ana görsel">
                                    </div>
                                    ${product.DigerGorseller.map(g => `
                                        <div class="thumb-item" data-image="${g.Url}">
                                            <img src="${g.Url}" alt="${g.Baslik}">
                                        </div>
                                    `).join('')}
                                </div>
                                <button class="thumb-nav next-thumb">›</button>
                            </div>
                        ` : ''}
                    </div>

                    <!-- Sağ: Ürün Bilgileri -->
                    <div class="product-info">
                        <div class="product-meta">
                            <a href="/kategori/${product.KategoriId}" class="category-link">${product.KategoriAdi || 'Kategori'}</a>
                            <div class="rating">
                                <span class="stars">
                                    ${generateStars(product.Rating || 4.5)}
                                </span>
                                <span class="rating-value">${(product.Rating || 4.5).toFixed(1)}</span>
                                <span class="review-count">(${product.YorumSayisi || 0} değerlendirme)</span>
                            </div>
                        </div>

                        <h1 class="product-title">${product.Ad}</h1>

                        ${product.KisaAciklama ? `
                            <div class="product-short-desc">${product.KisaAciklama}</div>
                        ` : ''}

                        <div class="product-price-section">
                            ${discountPercent ? `
                                <div class="discount-badge">%${discountPercent}</div>
                            ` : ''}
                            <div class="price-wrapper">
                                <span class="current-price">₺${(product.IndirimliFiyat || product.Fiyat).toLocaleString('tr-TR')}</span>
                                ${product.EskiFiyat && product.EskiFiyat > product.Fiyat ? `
                                    <span class="old-price">₺${product.EskiFiyat.toLocaleString('tr-TR')}</span>
                                ` : ''}
                            </div>

                            ${product.TaksitSecenekleri > 0 ? `
                                <div class="installment-info">
                                    <span>${taksitMiktari} x</span>
                                    <span class="installment-price">₺${taksitFiyati.toLocaleString('tr-TR')}</span>
                                </div>
                            ` : ''}
                        </div>

                        <div class="stock-status">
                            ${product.Stok > 0 ? `
                                <span class="in-stock">✓ Stokta var (${product.Stok} adet)</span>
                            ` : `
                                <span class="out-of-stock">✗ Stokta yok</span>
                            `}
                        </div>

                        ${product.Renkler && product.Renkler.length > 0 ? `
                            <div class="variant-section">
                                <h3>Renk Seçenekleri</h3>
                                <div class="color-options">
                                    ${product.Renkler.map(renk => `
                                        <button class="color-option ${renk.Id === product.SecilenRenkId ? 'active' : ''}"
                                                data-color-id="${renk.Id}"
                                                data-product-id="${renk.UrunId}"
                                                style="background-color: ${renk.HexKodu || '#f0f0f0'}"
                                                title="${renk.Ad}">
                                            <span class="color-name">${renk.Ad}</span>
                                        </button>
                                    `).join('')}
                                </div>
                            </div>
                        ` : ''}

                        ${product.Bedenler && product.Bedenler.length > 0 ? `
                            <div class="variant-section">
                                <h3>Beden Seçenekleri</h3>
                                <div class="size-options">
                                    ${product.Bedenler.map(beden => `
                                        <button class="size-option ${beden.Stok <= 0 ? 'out-of-stock' : ''}"
                                                data-size-id="${beden.Id}"
                                                data-stok="${beden.Stok}"
                                                ${beden.Stok <= 0 ? 'disabled' : ''}>
                                            ${beden.Ad}
                                            ${beden.Stok <= 0 ? '<span class="stock-status">(Tükendi)</span>' : ''}
                                        </button>
                                    `).join('')}
                                </div>
                            </div>
                        ` : ''}

                        <div class="purchase-section">
                            <div class="quantity-selector">
                                <button class="qty-btn minus" id="qtyMinus">-</button>
                                <input type="number" id="quantity" value="1" min="1" max="${product.Stok || 1}" step="1">
                                <button class="qty-btn plus" id="qtyPlus">+</button>
                            </div>

                            <button class="add-to-cart-large" data-product-id="${product.Id}">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                    <path d="M9 22a1 1 0 100-2 1 1 0 000 2zM20 22a1 1 0 100-2 1 1 0 000 2zM1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6" stroke="currentColor" stroke-width="2"/>
                                </svg>
                                Sepete Ekle
                            </button>

                            <button class="favorite-large" data-product-id="${product.Id}">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                    <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" stroke="currentColor" stroke-width="1.5" fill="none"/>
                                </svg>
                            </button>
                        </div>

                        <div class="delivery-info">
                            <div class="info-item">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                    <path d="M5 13h14v6H5z" stroke="currentColor" stroke-width="2"/>
                                    <circle cx="7" cy="19" r="2" stroke="currentColor" stroke-width="2"/>
                                    <circle cx="17" cy="19" r="2" stroke="currentColor" stroke-width="2"/>
                                    <path d="M5 13V7h14v6" stroke="currentColor" stroke-width="2"/>
                                </svg>
                                <span>Kargo Bedava</span>
                            </div>
                            <div class="info-item">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                                    <path d="M12 6v6l4 2" stroke="currentColor" stroke-width="2"/>
                                </svg>
                                <span>Hızlı Teslimat</span>
                            </div>
                            <div class="info-item">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                                    <path d="M12 2v4M12 18v4M4 12H2M6 12H4M20 12h-2M22 12h-2" stroke="currentColor" stroke-width="2"/>
                                    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2"/>
                                </svg>
                                <span>İade Garantisi</span>
                            </div>
                        </div>
                    </div>
                </div>
            `;

            document.getElementById('productDetailContent').innerHTML = html;
            document.getElementById('productTabs').style.display = 'block';

            // Açıklamayı doldur
            document.getElementById('productDescription').innerHTML = product.Aciklama || 'Ürün açıklaması bulunmamaktadır.';

            // Event'leri bağla - ÖNEMLİ: Burada tüm event'ler bağlanıyor
            attachDetailEvents(product.Stok);
        }

        function renderTechnicalDetails(product) {
            const detailsContainer = document.getElementById('technicalDetails');

            if (product.TeknikDetaylar && product.TeknikDetaylar.length > 0) {
                let tableHtml = '<table class="details-table">';
                product.TeknikDetaylar.forEach(detay => {
                    tableHtml += `
                        <tr>
                            <th>${detay.Baslik}</th>
                            <td>${detay.Deger}</td>
                        </tr>
                    `;
                });
                tableHtml += '</table>';
                detailsContainer.innerHTML = tableHtml;
            } else {
                detailsContainer.innerHTML = '<p>Teknik detay bulunmamaktadır.</p>';
            }
        }

        function renderReviews(product) {
            const reviewsContainer = document.getElementById('reviewsList');
            const reviewCountSpan = document.getElementById('reviewCount');

            if (product.Yorumlar && product.Yorumlar.length > 0) {
                reviewCountSpan.textContent = product.Yorumlar.length;

                let reviewsHtml = '';
                product.Yorumlar.forEach(yorum => {
                    reviewsHtml += `
                        <div class="review-item">
                            <div class="review-header">
                                <strong>${yorum.KullaniciAdi}</strong>
                                <div class="review-stars">
                                    ${generateStars(yorum.Puan)}
                                </div>
                                <span class="review-date">${new Date(yorum.Tarih).toLocaleDateString('tr-TR')}</span>
                            </div>
                            <div class="review-content">${yorum.Yorum}</div>
                        </div>
                    `;
                });
                reviewsContainer.innerHTML = reviewsHtml;
            } else {
                reviewCountSpan.textContent = '0';
                reviewsContainer.innerHTML = '<p>Henüz yorum yapılmamış. İlk yorumu siz yapın!</p>';
            }
        }

        function renderSimilarProducts(product) {
            const similarContainer = document.getElementById('similarProductsTrack');
            const similarSection = document.getElementById('similarProducts');

            if (product.BenzerUrunler && product.BenzerUrunler.length > 0) {
                similarSection.style.display = 'block';

                const html = product.BenzerUrunler.map(urun => `
                    <div class="product-card">
                        <div class="card-image-section">
                            <a href="/detay/${urun.Id}" class="product-image-link">
                                <img src="${urun.AnaGorsel || '/images/placeholder.jpg'}" alt="${urun.Ad}" class="product-image">
                            </a>
                        </div>
                        <div class="card-content">
                            <h3 class="product-title">
                                <a href="/detay/${urun.Id}">${urun.Ad}</a>
                            </h3>
                            <div class="product-price-section">
                                <span class="current-price">₺${(urun.IndirimliFiyat || urun.Fiyat).toLocaleString('tr-TR')}</span>
                                ${urun.EskiFiyat && urun.EskiFiyat > urun.Fiyat ? `
                                    <span class="old-price">₺${urun.EskiFiyat.toLocaleString('tr-TR')}</span>
                                ` : ''}
                            </div>
                        </div>
                    </div>
                `).join('');

                similarContainer.innerHTML = html;
                initSimilarSlider();
            }
        }

        function generateStars(rating) {
            let stars = '';
            for (let i = 1; i <= 5; i++) {
                stars += i <= rating ? '★' : '☆';
            }
            return stars;
        }

        // DÜZELTİLMİŞ: Adet arttırma/azaltma fonksiyonu
        function attachDetailEvents(maxStock) {
            // Miktar arttır/azalt - DOĞRUDAN ID'LER İLE
            const minusBtn = document.getElementById('qtyMinus');
            const plusBtn = document.getElementById('qtyPlus');
            const quantityInput = document.getElementById('quantity');

            console.log('Butonlar bulundu:', { minusBtn: !!minusBtn, plusBtn: !!plusBtn, quantityInput: !!quantityInput });

            if (minusBtn && plusBtn && quantityInput) {
                // Eski event listener'ları temizle
                const newMinusBtn = minusBtn.cloneNode(true);
                const newPlusBtn = plusBtn.cloneNode(true);
                minusBtn.parentNode.replaceChild(newMinusBtn, minusBtn);
                plusBtn.parentNode.replaceChild(newPlusBtn, plusBtn);

                const finalMinusBtn = document.getElementById('qtyMinus');
                const finalPlusBtn = document.getElementById('qtyPlus');
                const finalQuantityInput = document.getElementById('quantity');

                // Azalt butonu
                finalMinusBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    let val = parseInt(finalQuantityInput.value);
                    if (val > 1) {
                        finalQuantityInput.value = val - 1;
                        console.log('Adet azaltıldı:', finalQuantityInput.value);
                    }
                });

                // Arttır butonu
                finalPlusBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    let val = parseInt(finalQuantityInput.value);
                    let max = parseInt(finalQuantityInput.max);
                    if (val < max) {
                        finalQuantityInput.value = val + 1;
                        console.log('Adet arttırıldı:', finalQuantityInput.value);
                    }
                });

                // Input değişikliğini kontrol et
                finalQuantityInput.addEventListener('change', function() {
                    let val = parseInt(this.value);
                    let min = parseInt(this.min);
                    let max = parseInt(this.max);
                    if (isNaN(val)) val = min;
                    if (val < min) val = min;
                    if (val > max) val = max;
                    this.value = val;
                });
            } else {
                console.error('Adet butonları bulunamadı!');
            }

            // Sepete ekle
            const addToCartBtn = document.querySelector('.add-to-cart-large');
            if (addToCartBtn) {
                const newAddBtn = addToCartBtn.cloneNode(true);
                addToCartBtn.parentNode.replaceChild(newAddBtn, addToCartBtn);
                const finalAddBtn = document.querySelector('.add-to-cart-large');

                finalAddBtn.addEventListener('click', function() {
                    const productId = this.dataset.productId;
                    const quantity = document.getElementById('quantity').value;

                    const originalText = this.innerHTML;
                    this.innerHTML = `
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
                            <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Eklendi
                    `;
                    this.style.background = '#4CAF50';

                    setTimeout(() => {
                        this.innerHTML = originalText;
                        this.style.background = '';
                    }, 2000);

                    console.log(`Sepete eklendi: Ürün ID ${productId}, Adet: ${quantity}`);
                });
            }

            // Renk değiştirme
            document.querySelectorAll('.color-option').forEach(btn => {
                const newBtn = btn.cloneNode(true);
                btn.parentNode.replaceChild(newBtn, btn);
                newBtn.addEventListener('click', function() {
                    const newProductId = this.dataset.productId;
                    if (newProductId) {
                        window.location.href = `/detay/${newProductId}`;
                    }
                });
            });

            // Tab değiştirme
            document.querySelectorAll('.tab-btn').forEach(btn => {
                const newBtn = btn.cloneNode(true);
                btn.parentNode.replaceChild(newBtn, btn);
                newBtn.addEventListener('click', function() {
                    const tabId = this.dataset.tab;

                    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

                    this.classList.add('active');
                    const content = document.getElementById(`${tabId}Content`);
                    if (content) content.classList.add('active');
                });
            });

            // Thumbnail galeri
            initThumbnailGallery();
        }

        function initThumbnailGallery() {
            const thumbItems = document.querySelectorAll('.thumb-item');
            const mainImage = document.getElementById('mainProductImage');

            thumbItems.forEach(thumb => {
                const newThumb = thumb.cloneNode(true);
                thumb.parentNode.replaceChild(newThumb, thumb);

                newThumb.addEventListener('click', function() {
                    const newImage = this.dataset.image;
                    if (newImage && mainImage) {
                        mainImage.src = newImage;
                        document.querySelectorAll('.thumb-item').forEach(t => t.classList.remove('active'));
                        this.classList.add('active');
                    }
                });
            });

            // Önceki/sonraki butonları
            const prevBtn = document.querySelector('.prev-thumb');
            const nextBtn = document.querySelector('.next-thumb');
            const thumbnailsDiv = document.querySelector('.thumbnails');

            if (prevBtn && nextBtn && thumbnailsDiv) {
                const newPrevBtn = prevBtn.cloneNode(true);
                const newNextBtn = nextBtn.cloneNode(true);
                if (prevBtn.parentNode) prevBtn.parentNode.replaceChild(newPrevBtn, prevBtn);
                if (nextBtn.parentNode) nextBtn.parentNode.replaceChild(newNextBtn, nextBtn);

                const finalPrevBtn = document.querySelector('.prev-thumb');
                const finalNextBtn = document.querySelector('.next-thumb');

                let scrollAmount = 0;
                finalPrevBtn.addEventListener('click', () => {
                    scrollAmount -= 120;
                    thumbnailsDiv.scrollTo({ left: scrollAmount, behavior: 'smooth' });
                });
                finalNextBtn.addEventListener('click', () => {
                    scrollAmount += 120;
                    thumbnailsDiv.scrollTo({ left: scrollAmount, behavior: 'smooth' });
                });
            }
        }

        function initSimilarSlider() {
            const track = document.getElementById('similarProductsTrack');
            const prevBtn = document.querySelector('.similar-prev');
            const nextBtn = document.querySelector('.similar-next');

            if (!track || !prevBtn || !nextBtn) return;

            let currentPosition = 0;
            const cards = document.querySelectorAll('.similar-products .product-card');
            if (cards.length === 0) return;

            let cardWidth = cards[0].offsetWidth + 20;
            let visibleCards = Math.floor(document.querySelector('.similar-products-slider').offsetWidth / cardWidth);
            let maxPosition = Math.max(0, cards.length - visibleCards);

            function updateSliderPosition() {
                track.style.transform = `translateX(-${currentPosition * cardWidth}px)`;
                prevBtn.disabled = currentPosition === 0;
                nextBtn.disabled = currentPosition >= maxPosition;
            }

            const newPrevBtn = prevBtn.cloneNode(true);
            const newNextBtn = nextBtn.cloneNode(true);
            prevBtn.parentNode.replaceChild(newPrevBtn, prevBtn);
            nextBtn.parentNode.replaceChild(newNextBtn, nextBtn);

            const finalPrevBtn = document.querySelector('.similar-prev');
            const finalNextBtn = document.querySelector('.similar-next');

            finalPrevBtn.addEventListener('click', () => {
                if (currentPosition > 0) {
                    currentPosition--;
                    updateSliderPosition();
                }
            });

            finalNextBtn.addEventListener('click', () => {
                if (currentPosition < maxPosition) {
                    currentPosition++;
                    updateSliderPosition();
                }
            });

            updateSliderPosition();

            window.addEventListener('resize', () => {
                cardWidth = cards[0].offsetWidth + 20;
                visibleCards = Math.floor(document.querySelector('.similar-products-slider').offsetWidth / cardWidth);
                maxPosition = Math.max(0, cards.length - visibleCards);
                if (currentPosition > maxPosition) currentPosition = maxPosition;
                updateSliderPosition();
            });
        }

        function showError(message) {
            document.getElementById('productDetailContent').innerHTML = `
                <div class="error-message">
                    ${message}
                    <button onclick="location.reload()">Tekrar Dene</button>
                </div>
            `;
        }
    });
</script>