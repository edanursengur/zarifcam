@{
    ViewData["Title"] = "İletişim";
}
<link rel="stylesheet" href="~/css/Iletisim.css" />

<!-- Hero / Başlık -->
<section class="contact-hero">
    <div class="hero-inner">
        <h1>İletişim</h1>
        <p>Bize ulaşmak için aşağıdaki formu doldurabilir veya iletişim bilgilerimizi kullanabilirsiniz.</p>
    </div>
</section>

<!-- İletişim Formu ve Bilgiler -->
<section class="contact-main">
    <div class="contact-container">
        <!-- Form -->
        <div class="contact-form">
            <h2>Mesaj Gönder</h2>
            <form>
                <label for="name">Ad Soyad</label>
                <input type="text" id="name" name="name" placeholder="Adınız Soyadınız" required>

                <label for="email">E-posta</label>
                <input type="email" id="email" name="email" placeholder="ornek@adres.com" required>

                <label for="message">Mesajınız</label>
                <textarea id="message" name="message" rows="5" placeholder="Mesajınızı buraya yazın" required></textarea>

                <button type="submit" class="btn-primary">Gönder</button>
            </form>
        </div>

        <!-- İletişim Bilgileri -->
        <div class="contact-info">
            <h2>İletişim Bilgileri</h2>
            <ul>
                <li><strong>Adres:</strong> Beykoz/İstanbul</li>
                <li><strong>Telefon:</strong> +90 545 100 1686</li>
                <li>
                    <strong>Instagram:</strong>
                    <a href="https://www.instagram.com/zarif_cam/" target="_blank">
                        <i class="fab fa-instagram"></i> zarif_cam
                    </a>
@*                     <a href="https://facebook.com" target="_blank">
                        <i class="fab fa-facebook-f"></i> Facebook
                    </a>
                    <a href="https://linkedin.com" target="_blank">
                        <i class="fab fa-linkedin-in"></i> LinkedIn
                    </a> *@
                </li>
            </ul>
        </div>

            <!-- Harita -->
        <div class="contact-map" style="margin-top: 20px;">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3050.000000!2d29.1078!3d41.1162!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14cab7d8a5c12345%3A0xabcdef1234567890!2sYe%C5%9Fildere%20Sokak%2C%20Beykoz%2C%20%C4%B0stanbul!5e0!3m2!1str!2str!4v1700000000000!5m2!1str!2str"
                    width="100%"
                    height="300"
                    style="border:0;"
                    allowfullscreen=""
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
            </iframe>
        </div>
        </div>
    
</section>
