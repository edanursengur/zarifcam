<!-- HERO SLIDER -->
<section class="hero-slider">
    <div class="slides" id="heroSlides"></div>
    <div class="slider-nav" id="heroSliderDots"></div>
</section>
<!-- HIZLI ERİŞİM -->
<section class="quick-access">
    <div style="display:flex;justify-content: center;">
        <h2 class="section-title">Hızlı Erişim</h2>
    </div>
    <div class="quick-icons-wrapper" id="quickIconsWrapper">
        <div class="quick-icons" id="quickIcons">
            <!-- İkonlar buraya gelecek -->
        </div>
    </div>
    <div class="scroll-indicator" id="scrollIndicator"></div>
</section>

<!-- KATEGORİ SLIDER -->
<!-- KATEGORİ SLIDER -->
<section class="category-showcase">
    <div style="display:flex;justify-content: center;">
    <h2 class="section-title">Kategoriler</h2>
    </div>
    <div class="category-slider">
        <div class="category-track" id="categoryTrack">
            <!-- Buraya kategoriler gelecek -->
        </div>
    </div>
</section>
<!-- Ürün SLIDER -->

<section class="product-showcase">
    <div style="display:flex;justify-content: center;">
    <h2 class="section-title">Öne Çıkan Ürünler</h2>
    </div>
    <div class="product-slider-wrapper">
        <button class="slider-btn left" id="productPrev">&#10094;</button>
        <div class="product-slider" id="home-product-grid"></div>
        <button class="slider-btn right" id="productNext">&#10095;</button>
    </div>

    <a href="/Urunler" class="btn-primary discover-btn">Tüm Ürünleri Keşfet</a>
</section>
<!-- KATEGORİ VURGULAMA -->
<section class="featured-category">
    <div class="category-highlight">
        <div class="highlight-info">
            <h2 class="section-title">Yaz Koleksiyonu</h2>
            <p>Yeni renkler, yeni modeller</p>
            <a href="/kategori/yaz" class="btn-primary discover-btn">Koleksiyonu İncele</a>
        </div>
        <div class="highlight-image">
            <img src="~/images/collections/summer.jpg" alt="Yaz Koleksiyonu">
        </div>
    </div>

</section><!-- INSTAGRAM FEED -->
<div class="instagram-feedis">
    <section class="instagram-feed">
        <div class="instagram-header">
            <h2 class="section-title">Bizi Instagram'dan Takip Edin</h2>
            <div class="instagram-handle-container">
                <span class="instagram-icon">📷</span>
                <a href="https://instagram.com/zarif_cam" class="instagram-handle" target="_blank">
                    zarif_cam
