<!-- CTA / Footer Bağlantısı -->
<section class="about-cta">
    <div class="cta-container">
        <h2>Zarif Cam ile Hayatınıza Zarafet Katın</h2>
        <a href="/Urunler" class="btn-primary">Ürünleri Keşfet</a>
    </div>
</section>
