@{
    ViewData["Title"] = "Hakkımızda";
}
<link rel="stylesheet" href="~/css/Hakkimizda.css" />

<!-- Hero / Başlık Bloku -->
<section class="about-hero">
    <div class="hero-inner">
        <h1>Hakkımızda</h1>
        <p>Zarif Cam, yaşam alanlarınıza estetik ve kalite katmak için özenle tasarlanmış cam ürünler sunar.</p>
        <a href="/Urunler" class="btn-primary">Ürünlerimizi Keşfet</a>
    </div>
</section>

<!-- Marka Hikayesi / Story -->
<section class="about-story">
    <div class="story-container">
        <div class="story-text">
            <h2>Marka Hikayemiz</h2>
            <p>
                2005 yılında kurulan Zarif Cam, el işçiliği ile zamansız cam tasarımları üretmektedir.
                Misyonumuz, her mekâna uyum sağlayan ve detaylarda saklı zarafeti yansıtan ürünler sunmaktır.
            </p>
            <p>
                Vizyonumuz, modern tasarım ile kaliteli üretimi birleştirerek, müşterilerimizin hayatına değer katmaktır.
            </p>
        </div>
        <section class="hero-video">
            <video autoplay muted loop playsinline>
                <source src="~/medya/t.mp4" type="video/mp4">
                Tarayıcınız video etiketini desteklemiyor.
            </video>
        </section>


    </div>
</section>

<!-- Değerler / Values -->
<section class="about-values">
    <div class="values-container">
        <h2>Değerlerimiz</h2>
        <div class="values-grid">
            <div class="value-item">
                <h3>El Yapımı Cam</h3>
                <p>Her ürün, uzman eller tarafından özenle hazırlanır.</p>
            </div>
            <div class="value-item">
                <h3>Sürdürülebilir Üretim</h3>
                <p>Doğa dostu malzemelerle çevreye duyarlı üretim yapılır.</p>
            </div>
            <div class="value-item">
                <h3>Kalite ve Dayanıklılık</h3>
                <p>Ürünler uzun ömürlü ve yüksek kaliteli camdan üretilir.</p>
            </div>
            <div class="value-item">
                <h3>Zarif Tasarım</h3>
                <p>Modern yaşam ile uyumlu, zamansız çizgilere sahip ürünler.</p>
            </div>
        </div>
    </div>
</section>

