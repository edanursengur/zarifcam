@{
    ViewData["Title"] = "Kategori Yönetimi";
}
<link rel="stylesheet" href="~/css/Kategori/KategoriYonetimi.css" />

<section class="kategori-yonetimi">
    <div class="section-header">
        <h2>Kategori Yönetimi</h2>
        <button id="kategoriEkleBtn" class="btn-primary">Yeni Kategori Ekle</button>
    </div>

    <!-- Listeleme -->
    <div class="kategori-listesi">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Ad</th>
                    <th>Slug</th>
                    <th>Aktif</th>
                    <th>Aksiyon</th>
                </tr>
            </thead>
            <tbody id="kategoriGrid">
                <!-- JS ile doldurulacak -->
            </tbody>
        </table>
    </div>
</section>

<!-- Modal -->
<div id="kategoriModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h3 id="modalTitle">Yeni Kategori</h3>
        <form id="kategoriForm">
            <input type="hidden" id="kategoriId" />
            <div class="form-group">
                <label for="kategoriAd">Kategori Adı</label>
                <input type="text" id="kategoriAd" name="kategoriAd" required />
            </div>
            <div class="form-group">
                <label for="kategoriSlug">Slug</label>
                <input type="text" id="kategoriSlug" name="kategoriSlug" required />
            </div>
            <div class="form-group">
                <label>
                    <input type="checkbox" id="kategoriAktif" /> Aktif
                </label>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary">Kaydet</button>
            </div>
        </form>
    </div>
</div>

<script src="~/js/Kategori/KategoriYonetimi.js" asp-append-version="true"></script>
