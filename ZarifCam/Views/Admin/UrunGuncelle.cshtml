@{
    ViewData["Title"] = "Ürün Güncelle";
}
<link rel="stylesheet" href="~/css/Urun/UrunEkle.css" />

<section class="urun-guncelle">
    <div class="form-container">
        <h2>Ürünü Güncelle</h2>

        <form id="urunGuncelleForm" enctype="multipart/form-data">
            <!-- Ürün Id (hidden) -->
            <input type="hidden" id="urunId" name="urunId" />

            <!-- Ürün Adı -->
            <div class="form-group">
                <label for="urunAdi">Ürün Adı</label>
                <input type="text" id="urunAdi" name="urunAdi" placeholder="Örn: Kristal Sürahi" required>
            </div>

            <!-- Slug (otomatik) -->
            <input type="hidden" id="slug" name="slug" />

            <!-- Kategori -->
            <div class="form-group">
                <label for="kategori">Kategori</label>
                <select id="kategori" name="kategoriId" required>
                    <option value="">Seçiniz</option>
                    <option value="1">Sürahiler</option>
                    <option value="2">Kaseler</option>
                    <option value="3">Bardaklar</option>
                </select>
            </div>

            <!-- Fiyat -->
            <div class="form-group">
                <label for="fiyat">Fiyat (₺)</label>
                <input type="number" id="fiyat" name="fiyat" min="0" step="0.01" required>
            </div>

            <!-- Açıklama -->
            <div class="form-group">
                <label for="aciklama">Açıklama</label>
                <textarea id="aciklama" name="aciklama" rows="4"></textarea>
            </div>

            <!-- Görsel -->
            <div class="form-group">
                <label for="gorsel">Ürün Görseli</label>
                <input type="file" id="gorsel" name="gorsel" accept="image/*">
                <div class="preview">
                    <img id="gorselPreview" src="" alt="Görsel Önizleme" />
                </div>
            </div>

            <!-- IsFeatured -->
            <div class="form-group checkbox-group">
                <input type="checkbox" id="isFeatured" name="isFeatured">
                <label for="isFeatured">Öne Çıkan Ürün</label>
            </div>

            <!-- IsActive -->
            <div class="form-group checkbox-group">
                <input type="checkbox" id="isActive" name="isActive">
                <label for="isActive">Aktif</label>
            </div>

            <!-- Buton -->
            <div class="form-actions">
                <button type="submit" class="btn-primary">Güncelle</button>
            </div>
        </form>
    </div>
</section>

<script src="~/js/Urun/UrunGuncele.js" asp-append-version="true"></script>
